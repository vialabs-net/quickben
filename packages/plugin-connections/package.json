{
  "name": "@quickben/plugin-connections",
  "version": "0.0.0",
  "description": "Connections and credentials for Quickben: a provider registry, AES-256-GCM encrypted secrets, connection tests and an admin UI.",
  "keywords": [
    "quickben",
    "integrations",
    "connections",
    "credentials",
    "llm",
    "encryption"
  ],
  "homepage": "https://quickben.vialabs.net",
  "bugs": "https://github.com/vialabs-net/quickben/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vialabs-net/quickben.git",
    "directory": "packages/plugin-connections"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LOGOS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=4.0.0",
    "@ai-sdk/google": ">=4.0.0",
    "@ai-sdk/google-vertex": ">=5.0.0",
    "@ai-sdk/openai": ">=4.0.0",
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/next": "workspace:^",
    "ai": ">=7.0.0",
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/google-vertex": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@quickben/admin": {
      "optional": true
    },
    "@quickben/next": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/google": "4.0.118",
    "@ai-sdk/google-vertex": "5.0.138",
    "@ai-sdk/openai": "4.0.115",
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/db-memory": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/next": "workspace:^",
    "@quickben/tsconfig": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ai": "7.0.170",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
