{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Quickben landing page and documentation (https://quickben.vialabs.net).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/extract-samples.mjs && next typegen && tsc && tsc -p tsconfig.samples.json",
    "clean": "rm -rf .next .turbo public/_pagefind",
    "build:static": "DOCS_STATIC_EXPORT=1 next build && pagefind --site out --output-path out/_pagefind"
  },
  "dependencies": {
    "hast-util-to-jsx-runtime": "2.3.7",
    "next": "16.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@quickben/core": "workspace:^",
    "@quickben/db-memory": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "pagefind": "1.6.0",
    "typescript": "6.0.3",
    "zod": "^4.6.7"
  }
}
