exports[`sqlSource > writes the DDL for postgres (schema quickben) 1`] = `
"-- Generated by @quickben/db-drizzle from the Quickben config (postgres).
-- Run \`quickben-drizzle sql\` again after you change collections.

create schema if not exists "quickben";

create table "quickben"."blog-posts" (
  "id" text primary key,
  "createdAt" timestamp(3) with time zone not null,
  "updatedAt" timestamp(3) with time zone not null,
  "title" text not null,
  "slug" text,
  "body" text,
  "email" text,
  "site" text,
  "views" bigint,
  "rating" double precision,
  "published" boolean,
  "publishedOn" date,
  "publishedAt" timestamp(3) with time zone,
  "status" text not null,
  "labels" text[] default '{}' not null,
  "author" text,
  "tags" text[] default '{}' not null,
  "meta" jsonb
);

create index "blog-posts_createdAt_idx" on "quickben"."blog-posts" ("createdAt");

create index "blog-posts_title_idx" on "quickben"."blog-posts" ("title");

create unique index "blog-posts_slug_unique" on "quickben"."blog-posts" ("slug");

create index "blog-posts_labels_idx" on "quickben"."blog-posts" using gin ("labels");

create index "blog-posts_author_idx" on "quickben"."blog-posts" ("author");

create table "quickben"."people" (
  "id" text primary key,
  "createdAt" timestamp(3) with time zone not null,
  "updatedAt" timestamp(3) with time zone not null,
  "name" text not null
);

create index "people_createdAt_idx" on "quickben"."people" ("createdAt");
"
`;

