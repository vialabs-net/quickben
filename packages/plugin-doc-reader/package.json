{
  "name": "@quickben/plugin-doc-reader",
  "version": "0.2.0",
  "description": "Document reading for Quickben: versioned document types, a pipeline of text-layer and vision-LLM extractors, a test bench, quotas, usage and a job queue.",
  "keywords": [
    "quickben",
    "ocr",
    "document-extraction",
    "llm",
    "vision"
  ],
  "homepage": "https://quickben.vialabs.net",
  "bugs": "https://github.com/vialabs-net/quickben/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vialabs-net/quickben.git",
    "directory": "packages/plugin-doc-reader"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "default": "./dist/bullmq.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "default": "./dist/connections.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=1.1.0",
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/next": "workspace:^",
    "@quickben/plugin-connections": "workspace:^",
    "ai": ">=7.0.0",
    "bullmq": ">=5.0.0",
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "@quickben/admin": {
      "optional": true
    },
    "@quickben/next": {
      "optional": true
    },
    "@quickben/plugin-connections": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/db-memory": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/next": "workspace:^",
    "@quickben/plugin-connections": "workspace:^",
    "@quickben/plugin-tenancy": "workspace:^",
    "@quickben/tsconfig": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ai": "7.0.170",
    "bullmq": "6.7.6",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
