{
  "name": "@quickben/admin",
  "version": "0.0.0",
  "description": "Admin UI for Quickben, generated from your collections. React Server Components, server actions and Tailwind CSS v4.",
  "keywords": [
    "quickben",
    "nextjs",
    "admin",
    "react",
    "server-components"
  ],
  "homepage": "https://quickben.vialabs.net",
  "bugs": "https://github.com/vialabs-net/quickben/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vialabs-net/quickben.git",
    "directory": "packages/admin"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify && publint",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "peerDependencies": {
    "@quickben/core": "workspace:^",
    "@quickben/next": "workspace:^",
    "next": ">=15.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@quickben/core": "workspace:^",
    "@quickben/db-memory": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/next": "workspace:^",
    "@quickben/tsconfig": "workspace:*",
    "@tailwindcss/cli": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
