{
  "name": "@quickben/auth-firebase",
  "version": "0.0.0",
  "description": "Firebase Authentication for Quickben: session cookies, a sign-in route, a client helper with Google One Tap and a sign-in page.",
  "keywords": [
    "quickben",
    "auth",
    "firebase",
    "session-cookie",
    "google-one-tap"
  ],
  "homepage": "https://quickben.vialabs.net",
  "bugs": "https://github.com/vialabs-net/quickben/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vialabs-net/quickben.git",
    "directory": "packages/auth-firebase"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "peerDependencies": {
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/next": "workspace:^",
    "firebase": ">=12.0.0",
    "firebase-admin": ">=13.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@quickben/admin": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/next": "workspace:^",
    "@quickben/tsconfig": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
