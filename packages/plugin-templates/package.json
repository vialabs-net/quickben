{
  "name": "@quickben/plugin-templates",
  "version": "0.0.0",
  "description": "Document templates for Quickben: brands, versioned templates per kind, a safe expression language, HTML and PDF rendering, and a TipTap editor in the admin.",
  "keywords": [
    "quickben",
    "document-templates",
    "pdf",
    "tiptap",
    "letterhead"
  ],
  "homepage": "https://quickben.vialabs.net",
  "bugs": "https://github.com/vialabs-net/quickben/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vialabs-net/quickben.git",
    "directory": "packages/plugin-templates"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chromium": {
      "types": "./dist/chromium.d.ts",
      "default": "./dist/chromium.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && tailwindcss -i src/admin/styles.css -o dist/styles.css --minify && publint",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/next": "workspace:^",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "next": ">=15.0.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.50.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@quickben/admin": {
      "optional": true
    },
    "@quickben/next": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quickben/admin": "workspace:^",
    "@quickben/core": "workspace:^",
    "@quickben/db-memory": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/next": "workspace:^",
    "@quickben/plugin-tenancy": "workspace:^",
    "@quickben/tsconfig": "workspace:*",
    "@tailwindcss/cli": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extension-text-align": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.65.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
