exports[`prismaSource > writes Prisma models for postgres (schema quickben) 1`] = `
"// Generated by @quickben/db-drizzle from the Quickben config (postgres).
// Paste these models into schema.prisma. Keep @@map, @map, @db and the index names.
// Run \`quickben-drizzle sql --format prisma\` again after you change collections.
// List the schema in the datasource: schemas = ["quickben"].

model BlogPosts {
  id          String    @id
  createdAt   DateTime  @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3)
  title       String
  slug        String?   @unique(map: "blog-posts_slug_unique")
  body        String?
  email       String?
  site        String?
  views       BigInt?
  rating      Float?
  published   Boolean?
  publishedOn DateTime? @db.Date
  publishedAt DateTime? @db.Timestamptz(3)
  status      String
  labels      String[]  @default([])
  author      String?
  tags        String[]  @default([])
  meta        Json?     @db.JsonB

  @@index([createdAt], map: "blog-posts_createdAt_idx")
  @@index([title], map: "blog-posts_title_idx")
  @@index([labels(ops: ArrayOps)], type: Gin, map: "blog-posts_labels_idx")
  @@index([author], map: "blog-posts_author_idx")
  @@map("blog-posts")
  @@schema("quickben")
}

model People {
  id        String   @id
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  name      String

  @@index([createdAt], map: "people_createdAt_idx")
  @@map("people")
  @@schema("quickben")
}
"
`;

