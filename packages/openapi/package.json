{
  "name": "@quickben/openapi",
  "version": "0.4.1",
  "description": "OpenAPI 3.1 documents for Quickben endpoints and collections, and a CLI that checks API contracts.",
  "keywords": [
    "quickben",
    "openapi",
    "api",
    "contract",
    "zod"
  ],
  "homepage": "https://quickben.vialabs.net",
  "bugs": "https://github.com/vialabs-net/quickben/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vialabs-net/quickben.git",
    "directory": "packages/openapi"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "quickben-openapi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@quickben/core": "workspace:^"
  },
  "devDependencies": {
    "@quickben/core": "workspace:^",
    "@quickben/db-memory": "workspace:^",
    "@quickben/eslint-config": "workspace:*",
    "@quickben/tsconfig": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.12.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
